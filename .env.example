OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
WHISPER_MODEL=small
VAD_SILENCE_MS=450
VAD_MAX_UTTERANCE_MS=8000
VAD_PARTIAL_INTERVAL_MS=600
VAD_PARTIAL_WINDOW_MS=1200
QUESTROCK_LOG_TRANSCRIPTS=0
QUESTROCK_DEBUG_AUDIO=0

# Modal GPU inference (see docs/MODAL.md). Dev only.
# Packaged installers bake URL + token at build time. LOs do not get this file.
QUESTROCK_MODAL_URL=
QUESTROCK_MODAL_TOKEN=
